# ── MongoDB Atlas ────────────────────────────────────────────────────────
# Connection string from your Atlas cluster (Database > Connect > Drivers).
# See README "MongoDB Atlas Setup" for step-by-step instructions.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=apiwatch

# ── Monitoring defaults ─────────────────────────────────────────────────
DEFAULT_INTERVAL_SECONDS=300
DEFAULT_TIMEOUT_SECONDS=10
FAILURE_THRESHOLD=1
RECOVERY_THRESHOLD=1

# ── Retention ────────────────────────────────────────────────────────────
CHECK_RETENTION_DAYS=30

# ── Security ─────────────────────────────────────────────────────────────
MAX_REQUEST_BODY_SIZE_KB=64
FOLLOW_REDIRECTS=true
# 32-byte urlsafe-base64 Fernet key used to encrypt Discord webhook URLs at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme-generate-a-real-fernet-key

# Shared secret protecting every API route except /api/health. Leave empty
# for local dev (no auth prompt). SET THIS on any public deployment -- without
# it, anyone with the URL can create/delete monitors or read incident data,
# and could use your server to send outbound requests at arbitrary public
# URLs of their choosing. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
API_ACCESS_KEY=

# Per-user auth (email/password accounts, on top of API_ACCESS_KEY above).
# Signs session tokens -- required, no default. Rotating it logs everyone out.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=changeme-generate-a-real-jwt-secret
JWT_EXPIRE_DAYS=30

# ── Frontend / CORS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Comma-separated. Include both localhost and 127.0.0.1 for local dev since
# browsers treat them as different origins even though they're the same host.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Notifications ────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Frontend refresh ─────────────────────────────────────────────────────
MONITOR_REFRESH_SECONDS=30

# ── Scheduler ────────────────────────────────────────────────────────────
# Run the embedded APScheduler in this process. Keep this true on exactly ONE
# backend instance — running multiple replicas with this enabled duplicates
# scheduled checks. See README "Scheduler Architecture".
ENABLE_SCHEDULER=true

# ── Frontend build-time (frontend/.env) ─────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_MONITOR_REFRESH_SECONDS=30
